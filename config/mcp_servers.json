{
  "mcpServers": {
    "own_server": {
      "command": "python",
      "args": ["-m", "mcp_server.my_mcp_server"],
      "env": {
        "PYTHONPATH": "."
      },
      "enabled": true,
      "description": "M.Ber 自有 MCP 伺服器 (包含時間查詢與回音工具)"
    },
    "sqlite_server": {
      "command": "python",
      "args": ["-m", "mcp_server.third_party.sqlite_server"],
      "env": {
        "PYTHONPATH": "."
      },
      "enabled": true,
      "description": "第三方 SQLite 筆記與資料查詢 MCP 伺服器"
    },
    "calendar_server": {
      "command": "python",
      "args": ["-m", "mcp_server.third_party.calendar_server"],
      "env": {
        "PYTHONPATH": "."
      },
      "enabled": true,
      "description": "M.Ber 行事曆與行程管理 MCP 伺服器 (Calendar Events CRUD)"
    }
  }
}
